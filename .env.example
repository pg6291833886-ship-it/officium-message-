# Cloudflare R2. Names only. Never put real keys in this file or in frontend code.
# Free Standard allowance is documented in docs/PRODUCTION.md. Use Standard, not Infrequent Access.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional. Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Optional. R2 uses auto.
R2_REGION=
# Older names, used only when the matching R2_ variable above is empty.
